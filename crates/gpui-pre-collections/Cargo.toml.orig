zed-rev = "93d745668805029476e6d7fbb19652116fed51de"

[lib]
path = "src/collections.rs"
doctest = false
name = "collections"

[features]
test-support = []

[dependencies]
indexmap = { workspace = true }
rustc-hash = { workspace = true }
gpui_util = { workspace = true }

[lints]
workspace = true
