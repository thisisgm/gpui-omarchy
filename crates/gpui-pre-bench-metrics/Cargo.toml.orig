[package]
name = "gpui-pre-bench-metrics"
version = "0.3.9"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Zed's `bench_metrics` crate (gpui-pre snapshot of zed@93d7456)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "bench_metrics"
zed-version = "0.1.0"
zed-rev = "93d745668805029476e6d7fbb19652116fed51de"

[lib]
path = "src/bench_metrics.rs"
doctest = false
name = "bench_metrics"

[features]
test-support = []

[dependencies]
anyhow = { workspace = true }
criterion = { workspace = true }

[target.'cfg(unix)'.dependencies]
libc = { workspace = true }

[target.'cfg(target_os = "linux")'.dependencies]
perf-event = { workspace = true }

[lints]
workspace = true
