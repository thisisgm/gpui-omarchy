[package]
name = "gpui-pre-platform"
version = "0.3.9"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Zed's `gpui_platform` crate (gpui-pre snapshot of zed@93d7456)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "gpui_platform"
zed-version = "0.1.0"
zed-rev = "93d745668805029476e6d7fbb19652116fed51de"

[lib]
path = "src/gpui_platform.rs"
doctest = false
name = "gpui_platform"

[features]
default = ["multithreaded"]
multithreaded = []
bench-support = ["gpui/bench-support", "gpui_wgpu/bench-support"]
font-kit = []
inspector = ["gpui/inspector"]
test-support = [
    "gpui/test-support",
    "gpui_wgpu/test-support",
]
screen-capture = [
    "gpui/screen-capture",
    "gpui_linux/screen-capture",
]
runtime_shaders = []
wayland = ["gpui_linux/wayland"]
x11 = ["gpui_linux/x11"]

[dependencies]
anyhow = { workspace = true }
gpui = { workspace = true }

[target.'cfg(any(target_os = "linux", target_os = "freebsd"))'.dependencies]
gpui_linux = { workspace = true }

[target.'cfg(target_os = "linux")'.dependencies]
gpui_wgpu = { workspace = true, optional = true }

[lints]
workspace = true

[[bench]]
name = "inspector_render"
harness = false
required-features = ["bench-support"]

[[bench]]
name = "randomized_element_tree"
harness = false
required-features = ["bench-support"]
